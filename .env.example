# Vigil environment template. Copy to .env.local and fill in real values.
# Never commit real values. Every .env* file except this one is git-ignored.

# --- Core (shared by the web and worker services) ---------------------------
# PostgreSQL connection string (Railway provides this from its Postgres service)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# Disposable LOCAL database used by npm test; must differ from DATABASE_URL
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/vigil_test
# Public base URL of the web service, no trailing slash. Used for the CSRF
# Origin check and for Twilio signature verification (APP_URL + path).
APP_URL=http://localhost:3000
# 32 random bytes, base64. Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-openssl-rand-base64-32
# 32 random bytes, base64, for AES-256-GCM provider credentials.
# Generate with: openssl rand -base64 32. Changing it makes stored credentials unreadable.
ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
# development | production | test
NODE_ENV=development

# --- Provider keys (demo seed only) ------------------------------------------
# At runtime each workspace's credentials live encrypted in the database.
# These values are only copied into the demo workspace by the seed script (Step 15).

# Twilio WhatsApp Sandbox (Step 7)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Stripe test mode (Step 8)
STRIPE_SECRET_KEY=sk_test_replace
STRIPE_WEBHOOK_SECRET=whsec_replace

# Google OAuth 2.0 for Calendar (Step 10). Redirect URI:
# {APP_URL}/api/oauth/google/callback
GOOGLE_CLIENT_ID=replace.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Slack bot for escalation alerts (Step 9): Bot User OAuth Token from api.slack.com/apps
# scopes: chat:write, users:read, users:read.email
SLACK_BOT_TOKEN=xoxb-replace

# Optional email fallback for alerts (Step 9). Set NOTIFY_PROVIDER=resend to use it.
NOTIFY_PROVIDER=slack
RESEND_API_KEY=re_replace
RESEND_FROM=alerts@example.com
